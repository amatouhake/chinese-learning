{
  "name": "chinese-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "VITE_LOCAL_WORKER=true bun run build:web && wrangler dev",
    "build:web": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "build": "bun run build:web && bun run build:worker",
    "cf-types": "wrangler types --env-interface CloudflareBindings",
    "cf-types:check": "wrangler types --env-interface CloudflareBindings --check",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun run test:unit",
    "test:unit": "bun test tests/unit",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:browser": "bun run scripts/prepare-browser-tests.ts",
    "test:browser:run": "CHINESE_LEARNING_STAGED_MEDIA_ROOT=.generated/browser-test/public PLAYWRIGHT_BROWSERS_PATH=.generated/playwright-browsers playwright test",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:browser",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.generated/playwright-browsers playwright install chromium",
    "browser:install:ci": "PLAYWRIGHT_BROWSERS_PATH=.generated/playwright-browsers playwright install --with-deps chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run cf-types:check && bun run format:check && bun run lint && bun run typecheck && bun run test:unit && bun run test:integration && bun run build",
    "check:full": "bun run check && bun run verify:corpus && bun run verify:pronunciation && bun run test:browser",
    "db:migrate:local": "wrangler d1 migrations apply chinese-learning --local",
    "db:execute:local": "wrangler d1 execute chinese-learning --local",
    "import:v1": "bun run scripts/import-v1.ts",
    "import:pronunciation": "bun run scripts/import-pronunciation.ts",
    "extract:pronunciation-metadata": "bun run scripts/extract-pronunciation-metadata.ts",
    "verify:corpus": "bun run scripts/verify-full-import.ts",
    "verify:full-import": "bun run verify:corpus",
    "verify:pronunciation": "bun run scripts/verify-pronunciation.ts"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "ts-fsrs": "5.4.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
